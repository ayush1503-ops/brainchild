<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0F0F11"/>
      <stop offset="100%" style="stop-color:#1A1A2E"/>
    </linearGradient>
    <radialGradient id="glowGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#FF3366;stop-opacity:0.3"/>
      <stop offset="100%" style="stop-color:#FF3366;stop-opacity:0"/>
    </radialGradient>
  </defs>
  <rect width="512" height="512" fill="url(#bgGrad)"/>
  <circle cx="256" cy="256" r="180" fill="url(#glowGrad)"/>
  <g transform="translate(256, 256)">
    <!-- Mascot body - cute floating character -->
    <ellipse cx="0" cy="20" rx="80" ry="70" fill="#FF3366" opacity="0.9"/>
    <ellipse cx="0" cy="10" rx="70" ry="60" fill="#FF4477"/>
    
    <!-- Eyes -->
    <ellipse cx="-25" cy="-5" rx="18" ry="22" fill="white"/>
    <ellipse cx="25" cy="-5" rx="18" ry="22" fill="white"/>
    <ellipse cx="-28" cy="-8" rx="8" ry="10" fill="#0F0F11"/>
    <ellipse cx="22" cy="-8" rx="8" ry="10" fill="#0F0F11"/>
    <circle cx="-30" cy="-10" r="4" fill="white" opacity="0.8"/>
    <circle cx="20" cy="-10" r="4" fill="white" opacity="0.8"/>
    
    <!-- Mouth -->
    <path d="M-15 25 Q0 35 15 25" stroke="#0F0F11" stroke-width="4" fill="none" stroke-linecap="round"/>
    
    <!-- Antenna -->
    <path d="M-40 -60 Q-50 -90 -35 -100" stroke="#FF3366" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="-35" cy="-100" r="8" fill="#00E5FF"/>
    <path d="M40 -60 Q50 -90 35 -100" stroke="#FF3366" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="35" cy="-100" r="8" fill="#E2FE47"/>
    
    <!-- Little floating particles -->
    <circle cx="-100" cy="-80" r="4" fill="#00E5FF" opacity="0.6"/>
    <circle cx="110" cy="-60" r="3" fill="#E2FE47" opacity="0.6"/>
    <circle cx="-120" cy="60" r="3" fill="#FF3366" opacity="0.5"/>
    <circle cx="120" cy="80" r="4" fill="#00E5FF" opacity="0.5"/>
  </g>
</svg>