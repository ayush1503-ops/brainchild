<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="1280" height="720">
  <defs>
    <linearGradient id="nebulaBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0F0F11"/>
      <stop offset="50%" style="stop-color:#1A0A2E"/>
      <stop offset="100%" style="stop-color:#0A1A2E"/>
    </linearGradient>
    <radialGradient id="nebulaGlow1" cx="30%" cy="30%" r="60%">
      <stop offset="0%" style="stop-color:#FF3366;stop-opacity:0.2"/>
      <stop offset="100%" style="stop-color:#FF3366;stop-opacity:0"/>
    </radialGradient>
    <radialGradient id="nebulaGlow2" cx="70%" cy="70%" r="50%">
      <stop offset="0%" style="stop-color:#00E5FF;stop-opacity:0.15"/>
      <stop offset="100%" style="stop-color:#00E5FF;stop-opacity:0"/>
    </radialGradient>
  </defs>
  <rect width="1280" height="720" fill="url(#nebulaBg)"/>
  <ellipse cx="384" cy="216" rx="400" ry="300" fill="url(#nebulaGlow1)"/>
  <ellipse cx="896" cy="504" rx="350" ry="250" fill="url(#nebulaGlow2)"/>
  <g fill="none" stroke-width="1" opacity="0.3">
    <circle cx="200" cy="150" r="80" stroke="#FF3366"/>
    <circle cx="1080" cy="570" r="120" stroke="#00E5FF"/>
    <circle cx="640" cy="360" r="200" stroke="#E2FE47" opacity="0.2"/>
  </g>
  <text x="640" y="320" font-family="Oswald, sans-serif" font-size="64" font-weight="bold" fill="#F4F4F5" text-anchor="middle" opacity="0.9">PROJECT NEBULA</text>
  <text x="640" y="380" font-family="Inter, sans-serif" font-size="20" fill="#8A8A93" text-anchor="middle">Zero-G Survival • In Development</text>
  <polygon points="640,500 620,540 660,540" fill="#FF3366" opacity="0.6"/>
