<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="1280" height="720">
  <defs>
    <linearGradient id="neonBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0F0F11"/>
      <stop offset="50%" style="stop-color:#1A0A1A"/>
      <stop offset="100%" style="stop-color:#0A0A2E"/>
    </linearGradient>
    <linearGradient id="neonGrid" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#FF3366;stop-opacity:0.1"/>
      <stop offset="50%" style="stop-color:#00E5FF;stop-opacity:0.1"/>
      <stop offset="100%" style="stop-color:#FF3366;stop-opacity:0.1"/>
    </linearGradient>
  </defs>
  <rect width="1280" height="720" fill="url(#neonBg)"/>
  <g stroke-width="1" opacity="0.15">
    <line x1="0" y1="0" x2="1280" y2="720" stroke="#FF3366"/>
    <line x1="1280" y1="0" x2="0" y2="720" stroke="#00E5FF"/>
    <line x1="640" y1="0" x2="640" y2="720" stroke="#E2FE47"/>
    <line x1="0" y1="360" x2="1280" y2="360" stroke="#FF3366"/>
  </g>
  <ellipse cx="640" cy="360" rx="300" ry="150" fill="none" stroke="#FF3366" stroke-width="3" opacity="0.4"/>
  <ellipse cx="640" cy="360" rx="250" ry="120" fill="none" stroke="#00E5FF" stroke-width="2" opacity="0.3"/>
  <text x="640" y="320" font-family="Oswald, sans-serif" font-size="64" font-weight="bold" fill="#F4F4F5" text-anchor="middle" opacity="0.95">NEON DRIFTER</text>
  <text x="640" y="380" font-family="Inter, sans-serif" font-size="20" fill="#8A8A93" text-anchor="middle">Cyberpunk Racing • Released 2025</text>
  <polygon points="640,500 620,540 660,540" fill="#00E5FF" opacity="0.6"/>
</svg>