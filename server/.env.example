# Database
DATABASE_URL="postgresql://user:password@localhost:5432/brainchild_games?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret-min-32-chars-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Admin (first super admin created via seed)
ADMIN_EMAIL="admin@brainchild.games"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Studio Admin"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,image/gif"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100