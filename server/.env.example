# =============================================================================
# Brainchild Studio API — environment
# -----------------------------------------------------------------------------
# Copy to .env for local development. For Vercel, set these in the Vercel
# dashboard (Project → Settings → Environment Variables) instead.
# =============================================================================

# Database (PostgreSQL)
# Local: points at the embedded dev Postgres started by `npm run db:up --prefix server`
# (port 55432, user/password brainchild — matches the default printed by db:up).
# Use your own instance's URL if you prefer.
# Vercel: override with a managed Postgres URL (Neon pooled endpoint recommended,
# Supabase Postgres, or RDS) — never ship this dev default to production.
DATABASE_URL="postgresql://brainchild:brainchild@127.0.0.1:55432/brainchild_games?schema=public"

# JWT (minimum 32 characters each — required in production)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-change-in-production"
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API.
# On Vercel set this to your production URL (same-origin anyway).
FRONTEND_ORIGIN="http://localhost:3000"
# Set to "true" on Vercel / any TLS-terminating host (default: true in prod).
# FORCE_HTTPS=true
# COOKIE_SECURE=true
TRUST_PROXY=1

# Admin (first super admin created by `npm run seed`)
# Primary studio owner — always seeded as SUPER_ADMIN
# Temporary shared password — matches seed.ts, the reset script and migration
# 0003, so a fresh or locked-out admin can always sign in. Must be 12+
# characters (the app rejects shorter passwords); replace it with a strong
# unique value before real use (Settings → Change Your Password).
ADMIN_EMAIL="brainchildgamesin@gmail.com"
ADMIN_PASSWORD="Brainchild@2026"
ADMIN_NAME="Brainchild Games"

# --- Temporary password (see TEMPORARY_PASSWORD.md) --------------------------
# Used when ADMIN_PASSWORD / BRAINCHILD_ADMIN_PASSWORD are not set. Override it
# to install a different temporary value without editing any file:
#   TEMPORARY_ADMIN_PASSWORD="Another@Temp2026" npm run seed --prefix server
# TEMPORARY_ADMIN_PASSWORD="Brainchild@2026"
# Set to "true" to stop the API from reporting whether the signed-in admin is
# still using the shared temporary password (it stops the console warning):
# TEMPORARY_PASSWORD_DISABLED=false

# --- Supabase (server side) --------------------------------------------------
# Project URL + keys from Supabase Dashboard → Project Settings → API Keys.
# The service-role key bypasses RLS: it lives ONLY here / in Vercel's server
# env — never in a VITE_ variable, never in client code, never committed.
# Used for: Supabase Storage uploads and the admin password-reset email
# (Supabase Auth sends the recovery email; see PASSWORD_RESET_CHANNEL below).
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SUPABASE-SERVICE-ROLE-KEY"
# Optional: the publishable/anon key (same value as VITE_SUPABASE_ANON_KEY).
# Only used as the `apikey` of the public /auth/v1/recover call so it is
# indistinguishable from a browser-initiated one. Falls back to the key above.
SUPABASE_ANON_KEY="YOUR-SUPABASE-PUBLISHABLE-ANON-KEY"

# --- Media storage -----------------------------------------------------------
# Driver: "local" (dev, disk under UPLOAD_DIR, served from /uploads) or
# "supabase" (serverless/Vercel — uploads go to a Supabase Storage bucket).
# Auto-detected: supabase when both SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are present. Set explicitly to override.
STORAGE_DRIVER=local
# Public bucket created by supabase/migrations/0004_add_media_bucket.sql
STORAGE_BUCKET=media
UPLOAD_DIR="./uploads"
# Max image size in bytes (4 MB keeps uploads under Vercel's 4.5 MB body limit)
MAX_UPLOAD_BYTES=4194304

# --- Admin password reset ----------------------------------------------------
# Who delivers the "reset your password" email:
#   auto     (default) Supabase Auth when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#            are set, otherwise the SMTP/console mailer below.
#   supabase always Supabase Auth (boot fails if it is not configured).
#   smtp     never Supabase — always the SMTP/console mailer.
# Either way the admin credential stays in this API's `admin_users` table;
# Supabase only carries the email and proves the recipient opened the link.
# Supabase setup (once, in the dashboard): Authentication → URL Configuration →
# add <APP_BASE_URL>/admin/reset-password to "Redirect URLs".
PASSWORD_RESET_CHANNEL=auto
# Public origin the reset link points back to (no trailing slash).
# Falls back to FRONTEND_ORIGIN, then Vercel's URL, then http://localhost:3000.
# Never derived from request headers (host-header-injection safe).
APP_BASE_URL="http://localhost:3000"
# A Supabase recovery session older than this cannot set a new password.
RECOVERY_SESSION_MAX_AGE_MINUTES=60
# Development only (ignored in production): return the reset link in the
# forgot-password response so the flow can be exercised without an inbox.
# Set to false locally to make Supabase/SMTP actually send the email.
DEV_EXPOSE_RESET_LINK=true

# Mail — SMTP fallback, used when PASSWORD_RESET_CHANNEL resolves to smtp.
# MAIL_TRANSPORT defaults to "console" in development (prints the link to the
# log) and "smtp" in production.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Brainchild Studio <no-reply@brainchild.games>"

# --- Rate limiting -----------------------------------------------------------
# General API limiter (per IP per window). Code default is 900 per 15 minutes;
# values below ~300 make `npm run security:test` trip the limiter.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=900
# Forgot/reset-password attempts per IP per hour (default 10).
# RATE_LIMIT_RESET_MAX=10
