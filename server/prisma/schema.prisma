generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  role          AdminRole      @default(EDITOR)
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activities    AdminActivity[]
  resetTokens   PasswordResetToken[]

  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model AdminActivity {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("admin_activity")
}

model Game {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  subtitle        String?
  genre           String
  categories      String[]     @default(["Indie"])
  rating          Float?       @default(0)
  price           String       @default("Wishlist free")
  salePrice       String?
  currency        String       @default("INR")
  isFree          Boolean      @default(false)
  platforms       String[]     @default(["PC (Steam)"])
  status          GameStatus   @default(IN_DEVELOPMENT)
  releaseYear     String       @default("2027")
  description     String
  longDescription String       @default("")
  heroImage       String?
  secondaryImage  String?
  screenshots     String[]     @default([])
  trailerUrl      String?
  tags            String[]     @default([])
  features        String[]     @default([])
  gameplayMechanics GameplayMechanic[]
  devStory        String       @default("")
  storeLinks      StoreLink[]
  awards          String[]     @default([])
  featured        Boolean      @default(false)
  featuredOrder   Int?
  published       Boolean      @default(false)
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([slug])
  @@index([status])
  @@index([published])
  @@index([featured])
  @@map("games")
}

enum GameStatus {
  IN_DEVELOPMENT
  EARLY_ACCESS
  WISHLIST_NOW
  AVAILABLE_NOW
}

model GameplayMechanic {
  id          String @id @default(cuid())
  gameId      String
  title       String
  description String
  game        Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("gameplay_mechanics")
}

model StoreLink {
  id        String @id @default(cuid())
  gameId    String
  name      String
  url       String
  badge     String?
  game      Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("store_links")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String   @default("#6C4CF1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  newsPosts NewsPost[]

  @@map("categories")
}

model NewsPost {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorName  String       @default("Studio Team")
  authorRole  String       @default("Editor")
  authorImage String?
  tags        String[]     @default([])
  status      PostStatus   @default(DRAFT)
  featured    Boolean      @default(false)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([publishedAt])
  @@map("news_posts")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  interests   String[] @default([])
  status      SubscriberStatus @default(ACTIVE)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?
  source      String?  @default("website")
  metadata    Json?

  @@index([email])
  @@index([status])
  @@map("subscribers")
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

model WebsiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  section   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("website_content")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  subject   String
  projectType String
  budget    String?
  message   String
  status    ContactStatus @default(UNREAD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

enum ContactStatus {
  UNREAD
  REVIEWED
  ARCHIVED
}

model Job {
  id              String   @id @default(cuid())
  title           String
  department      String
  location        String
  type            JobType  @default(FULL_TIME)
  experience      String
  description     String
  responsibilities String[] @default([])
  requirements    String[] @default([])
  niceToHave      String[] @default([])
  perks           String[] @default([])
  status          JobStatus @default(OPEN)
  postedDate      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("jobs")
}

enum JobType {
  FULL_TIME
  CONTRACT
  FREELANCE
  REMOTE_HYBRID
}

enum JobStatus {
  OPEN
  CLOSED
}

model PasswordResetToken {
  id           String    @id @default(cuid())
  adminUserId  String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([adminUserId])
  @@map("password_reset_tokens")
}