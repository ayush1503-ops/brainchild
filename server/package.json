{
  "name": "brainchild-admin-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Brainchild Studio — secure API and admin/CMS backend. Runtime and dev dependencies are installed from the repository root's package.json; only the local-dev-only optional packages (embedded Postgres for the dev database, nodemailer for SMTP) are installed here.",
  "optionalDependencies": {
    "embedded-postgres": "17.10.0-beta.17",
    "nodemailer": "^6.9.16"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:setup": "node scripts/migrate.mjs && tsx scripts/seed.ts",
    "db:up": "node scripts/dev-db.mjs start",
    "db:down": "node scripts/dev-db.mjs stop",
    "db:status": "node scripts/dev-db.mjs status",
    "seed": "tsx scripts/seed.ts",
    "admin:reset-brainchild": "tsx scripts/reset-brainchild-password.ts",
    "admin:set-password": "tsx scripts/reset-brainchild-password.ts",
    "security:test": "tsx src/scripts/security-test.ts",
    "smoke:test": "tsx src/scripts/smoke-test.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "db:migrate": "node scripts/migrate.mjs"
  }
}
