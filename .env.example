# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Supabase (frontend/public site)
#
# These are Vite-prefixed so they are embedded in the browser bundle. Only the
# publishable (anon) key is safe here — never put the service-role key in a
# VITE_ variable or in any client-side code.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-SUPABASE-PUBLISHABLE-ANON-KEY"

# Primary admin account (SUPER_ADMIN) — always valid
VITE_ADMIN_EMAIL="brainchildgamesin@gmail.com"

# (Optional) Override where the dev server proxies /api and /uploads to.
VITE_API_PROXY="http://127.0.0.1:3001"

# =============================================================================
# Vercel deployment — what to set in the Vercel dashboard
# -----------------------------------------------------------------------------
# Frontend / build-time (inlined into the browser bundle):
#   VITE_SUPABASE_URL          – your Supabase project URL
#   VITE_SUPABASE_ANON_KEY     – publishable anon key (safe to expose)
#
# API / serverless runtime (used by the Express app in api/[...path].ts):
#   DATABASE_URL               – managed Postgres (Supabase pooler URL or Neon)
#   NODE_ENV                   – production
#   JWT_SECRET                 – 32+ chars (openssl rand -hex 32)
#   JWT_REFRESH_SECRET         – 32+ chars
#   FRONTEND_ORIGIN            – deployed origin, e.g. https://www.brainchildapp.com
#   APP_BASE_URL               – same origin; the password-reset link points here
#   STORAGE_DRIVER             – supabase
#   SUPABASE_URL               – same project URL as VITE_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY  – service-role key (server-side only, never VITE_)
#   SUPABASE_ANON_KEY          – same value as VITE_SUPABASE_ANON_KEY (optional)
#   STORAGE_BUCKET             – media
#   PASSWORD_RESET_CHANNEL     – auto (Supabase Auth sends the reset email)
#   SERVE_FRONTEND             – false  (Vercel serves the static build)
#
# Admin password reset — with the Supabase variables above set, the API asks
# Supabase Auth to email the recovery link (no SMTP needed). Supabase's built-in
# mailer only delivers to members of the Supabase project team; add the admin
# address to the team or configure custom SMTP under Authentication → SMTP in
# the Supabase dashboard. The redirect URL <APP_BASE_URL>/admin/reset-password
# must be listed under Authentication → URL Configuration → Redirect URLs.
#
# SMTP fallback (only when Supabase is not configured or
# PASSWORD_RESET_CHANNEL=smtp). Without SMTP_HOST the reset form still shows the
# generic confirmation, the API returns emailDeliveryEnabled:false and logs
# "Password reset email was not delivered".
#   SMTP_HOST       – e.g. smtp.postmarkapp.com
#   SMTP_PORT       – 587 (STARTTLS) or 465 (implicit TLS)
#   SMTP_USER       – provider username (no leading/trailing spaces)
#   SMTP_PASSWORD   – provider password / API token
#   MAIL_FROM       – "Brainchild Studio <no-reply@yourdomain>"
#   MAIL_TRANSPORT  – "smtp" | "console" (console prints the link to the log)
#
# Full API variable reference: server/.env.example — flow details: supabase/README.md
# =============================================================================
