# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Supabase (frontend/public site)
#
# These are Vite-prefixed so they are embedded in the browser bundle. Only the
# publishable (anon) key is safe here — never put the service-role key in a
# VITE_ variable or in any client-side code.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-SUPABASE-PUBLISHABLE-ANON-KEY"

# Primary admin account (SUPER_ADMIN) — always valid
VITE_ADMIN_EMAIL="brainchildgamesin@gmail.com"

# (Optional) Override where the dev server proxies /api and /uploads to.
VITE_API_PROXY="http://127.0.0.1:3001"

# =============================================================================
# Vercel deployment — what to set in the Vercel dashboard
# -----------------------------------------------------------------------------
# Frontend / build-time (inlined into the browser bundle):
#   VITE_SUPABASE_URL          – your Supabase project URL
#   VITE_SUPABASE_ANON_KEY     – publishable anon key (safe to expose)
#
# API / serverless runtime (used by the Express app in api/[...path].ts):
#   DATABASE_URL               – managed Postgres (Neon pooled URL recommended)
#   NODE_ENV                   – production
#   JWT_SECRET                 – 32+ chars (openssl rand -hex 32)
#   JWT_REFRESH_SECRET         – 32+ chars
#   FRONTEND_ORIGIN            – your Vercel URL, e.g. https://brainchild.vercel.app
#   STORAGE_DRIVER             – supabase
#   SUPABASE_URL               – same project URL as VITE_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY  – service-role key (server-side only, never VITE_)
#   STORAGE_BUCKET             – media
#   SERVE_FRONTEND             – false  (Vercel serves the static build)
#
# Optional mail (password-reset emails):
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, MAIL_FROM, APP_BASE_URL
#
# Full API variable reference: server/.env.example
# =============================================================================
